# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (also consumed by docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering

# SQS (MiniStack locally; omit AWS_ENDPOINT_URL to target real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_OUTBOX_QUEUE_NAME=wager-events.fifo
