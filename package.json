{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed Wagering Processor — Jungle Gaming backend challenge",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:load": "bun scripts/load-test.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres sqs && docker compose run --rm sqs-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "app:up": "docker compose --profile app up -d --build --scale app=3",
    "app:down": "docker compose --profile app down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
